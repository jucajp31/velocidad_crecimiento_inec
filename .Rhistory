### construccion de grupos de edad (considerando edad en meses)
setnames(R3_filt, "edad", "edaddias")
R2_filt <- R2_filt %>%
mutate(gedad = case_when(
edaddias < 183 ~ "<6m",
edaddias < 365 ~ "6m - <1a",
edaddias < 731 ~ "1a - <2a",
edaddias < 1096 ~ "2a - <3a",
edaddias < 1461 ~ "3a - <4a",
edaddias < 1826 ~ "4a - <5a",
TRUE ~ NA_character_
))
R3_filt <- R3_filt %>%
mutate(gedad = case_when(
edaddias < 183 ~ "<6m",
edaddias < 365 ~ "6m - <1a",
edaddias < 731 ~ "1a - <2a",
edaddias < 1096 ~ "2a - <3a",
edaddias < 1461 ~ "3a - <4a",
edaddias < 1826 ~ "4a - <5a",
TRUE ~ NA_character_
))
## calculos dcronica
R2_filt <- R2_filt %>%
mutate(dcronica = case_when(
(zlen >= -6 & zlen < -2) & (edaddias < 1826 & !is.na(edaddias)) ~ 1,
(zlen >= -2 & zlen <= 6) & (edaddias < 1826 & !is.na(edaddias)) ~ 0,
TRUE ~ NA_real_
))
R3_filt <- R3_filt %>%
mutate(dcronica = case_when(
(zlen >= -6 & zlen < -2) & (edaddias < 1826 & !is.na(edaddias)) ~ 1,
(zlen >= -2 & zlen <= 6) & (edaddias < 1826 & !is.na(edaddias)) ~ 0,
TRUE ~ NA_real_
))
setorder(R2_filt, id_per, edaddias)
R2_filt[, dcronica_prev:=shift(dcronica)]
R3_filt[, dcronica_prev:=shift(dcronica)]
descriptivosR2 <- R2_filt[levantamiento=="endi" & d_dia_talla_cat %in% c("Velocidad de crecimiento dentro del rango esperado"), .(
N = .N,
Media = mean(d_dia_talla, na.rm = TRUE),
Desv_Est = sd(d_dia_talla, na.rm = TRUE),
Mediana = median(d_dia_talla, na.rm = TRUE),
Minimo = min(d_dia_talla, na.rm = TRUE),
Maximo = max(d_dia_talla, na.rm = TRUE),
dcronica_endi =mean(dcronica),
dcronica_MSP =mean(dcronica_prev),
Ronda="R2"
), by=.(gedad)]
descriptivosR3 <- R3_filt[levantamiento=="endi" & d_dia_talla_cat %in% c("Velocidad de crecimiento dentro del rango esperado"), .(
N = .N,
Media = mean(d_dia_talla, na.rm = TRUE),
Desv_Est = sd(d_dia_talla, na.rm = TRUE),
Mediana = median(d_dia_talla, na.rm = TRUE),
Minimo = min(d_dia_talla, na.rm = TRUE),
Maximo = max(d_dia_talla, na.rm = TRUE),
dcronica_endi =mean(dcronica),
dcronica_MSP =mean(dcronica_prev),
Ronda="R3"
), by=.(gedad)]
descriptivos_all <- rbind(descriptivosR2, descriptivosR3)
descriptivos_all2 <- dcast(descriptivos_all, gedad ~ Ronda, value.var = c("N", "Media", "Desv_Est", "Mediana", "Minimo", "Maximo", "dcronica_endi", "dcronica_MSP"))
descriptivos_all3 <- descriptivos_all2[, gedad:=factor(gedad, levels = c("<6m", "6m - <1a", "1a - <2a", "2a - <3a", "3a - <4a", "4a - <5a"))][order(gedad)][, .(gedad, N_R2, N_R3, Media_R2, Media_R3, Desv_Est_R2, Desv_Est_R3, Mediana_R2, Mediana_R3, Maximo_R2, Maximo_R3)]
descriptivos_dcronica <- descriptivos_all2[, gedad:=factor(gedad, levels = c("<6m", "6m - <1a", "1a - <2a", "2a - <3a", "3a - <4a", "4a - <5a"))][order(gedad)][, .(gedad, N_R2, N_R3, dcronica_endi_R2, dcronica_endi_R3,  dcronica_MSP_R2, dcronica_MSP_R3)]
colnames(descriptivos_all3) <- c("Grupo Edad",
"Ronda 2", "Ronda 3",
"Ronda 2", "Ronda 3",
"Ronda 2", "Ronda 3",
"Ronda 2", "Ronda 3",
"Ronda 2", "Ronda 3")
# 3. Generar la tabla con formato avanzado
descriptivos_all3 %>%
kable(format = "html", digits = 3, align = "c", caption = "Resumen Estadístico por Grupo de Edad (R2 vs R3)") %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed", "responsive"),
full_width = FALSE) %>%
add_header_above(c(" " = 1,
"Tamaño Muestra (N)" = 2,
"Media" = 2,
"Desv. Estándar" = 2,
"Mediana" = 2,
"Máximo" = 2))
### graficos
R2_filt[, peso:=NULL]
R3_filt[, peso:=NULL]
setnames(R3_filt, "n_ctlr", "n_ctrl")
R2_filt$fuente <- "Ronda 2"
R3_filt$fuente <- "Ronda 3"
R_comb <- rbind(R2_filt, R3_filt)
men5 <- ggplot(R_comb[levantamiento=="endi" & d_dia_talla_cat %in% c("Velocidad de crecimiento dentro del rango esperado"), ], aes(x = fuente, y = d_dia_talla, fill = fuente)) +
geom_boxplot(show.legend = FALSE) +
labs(
title = "Niños/as menores de 5 años",
y = "Valores"
) +
theme_minimal()
